# KisanMandi configuration
# Copy to `.env` and fill in. NEVER commit the real .env — it is in .gitignore.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# data.gov.in / Agmarknet  (REQUIRED for a usable ingest)
# ---------------------------------------------------------------------------
# Register a FREE personal key: https://data.gov.in/user/register
# Without it the shared demo key caps every response at 10 records, which turns
# a 16-request daily pull into ~1,700 requests. Get the key before week 2.
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# Politeness settings. Do not lower MIN_REQUEST_INTERVAL_SECONDS — getting
# throttled (or blocked) is slower than being polite.
PAGE_SIZE=1000
MAX_PAGES=40
MIN_REQUEST_INTERVAL_SECONDS=1.0
MAX_RETRIES=5
REQUEST_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Local development: SQLite, zero setup.
DATABASE_URL=sqlite:///./data/kisanmandi.db
DATA_DIR=./data

# Deployment (Oracle Always Free VM):
# DATABASE_URL=postgresql+psycopg://kisanmandi:CHANGEME@localhost:5432/kisanmandi

# ---------------------------------------------------------------------------
# Raw landing zone
# ---------------------------------------------------------------------------
# local = filesystem (default, free, fine for development)
# s3    = Cloudflare R2 / Backblaze B2 / AWS S3 (10 GB free on R2, zero egress)
LANDING_BACKEND=local
LANDING_LOCAL_DIR=./data/landing

# Only needed when LANDING_BACKEND=s3. For Cloudflare R2:
#   endpoint: https://<account-id>.r2.cloudflarestorage.com
#   region:   auto
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---------------------------------------------------------------------------
# Data-quality thresholds  (rupees per quintal)
# ---------------------------------------------------------------------------
# Every BLOCKED row here becomes a number in your published quality report.
# Pick these from the real distribution once you have a week of data.
MIN_PLAUSIBLE_PRICE=10
MAX_PLAUSIBLE_PRICE=100000
STALENESS_DAYS=7

# ---------------------------------------------------------------------------
# Advisory model assumptions
# ---------------------------------------------------------------------------
FORECAST_HORIZON_DAYS=7
HOLD_THRESHOLD_PCT=3.0

# TRANSPORT_COST_PER_QUINTAL is the weakest number in this project. It is a
# guess until a real farmer or transporter gives you one. Replace it in week 2
# and say in your README where the number came from.
TRANSPORT_COST_PER_QUINTAL=150

# Refuse to advise below this many daily observations. Refusing is a feature.
MIN_HISTORY_POINTS=21

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
